{
  "version": 2,
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "env": {
    "VITE_API_BASE_URL": "@api_base_url",
    "VITE_SOCKET_URL": "@socket_url"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "http://localhost:5000/api/$1",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
